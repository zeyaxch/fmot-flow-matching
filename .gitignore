!runs/2d/**/*.pt
!runs/mnist/*/ema.pt
!runs/mnist/classifier.pt
!runs/mnist/test_features.npz
runs/mnist/*_smoke/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/
